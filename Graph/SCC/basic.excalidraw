    {
      "id": "mtpj5vkpwbfbvbiy3yh",
      "type": "text",
      "x": -309.3350586719515,
      "y": -22.89772447669452,
      "width": 700,
      "height": 500,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": [],
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "ap",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Tarjan's SCC — Dry Run (indent = recursion depth = current stack depth)\n\nnode=0, disc=0 low=0\n  node=1, disc=1 low=1\n    node=2, disc=2 low=2\n      (back-edge 2->0, low[2]=0)\n      node=3, disc=3 low=3\n        node=4, disc=4 low=4\n          node=5, disc=5 low=5\n            (back-edge 5->3, low[5]=3)\n            node=6, disc=6 low=6\n              node=7, disc=7 low=7\n              node=7 IS ROOT -> sccs={7}\n              (return to node=6, low[6]=min(6,7)=6)\n            node=6 IS ROOT -> sccs={7} {6}\n            (return to node=5, low[5]=min(3,6)=3)\n          (return to node=4, low[4]=min(4,3)=3)\n        (return to node=3, low[3]=min(3,3)=3)\n      node=3 IS ROOT -> sccs={7} {6} {5,4,3}\n      (return to node=2, low[2]=min(0,3)=0)\n    (return to node=1, low[1]=min(1,0)=0)\n  (return to node=0, low[0]=min(0,0)=0)\nnode=0 IS ROOT -> sccs={7} {6} {5,4,3} {2,1,0}\n\nFINAL: sccs = {0,1,2}  {3,4,5}  {6}  {7}",
      "roughness": 1,
      "roundness": null,
      "seed": 1699872845,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Tarjan's SCC — Dry Run (indent = recursion depth = current stack depth)\n\nnode=0, disc=0 low=0\n  node=1, disc=1 low=1\n    node=2, disc=2 low=2\n      (back-edge 2->0, low[2]=0)\n      node=3, disc=3 low=3\n        node=4, disc=4 low=4\n          node=5, disc=5 low=5\n            (back-edge 5->3, low[5]=3)\n            node=6, disc=6 low=6\n              node=7, disc=7 low=7\n              node=7 IS ROOT -> sccs={7}\n              (return to node=6, low[6]=min(6,7)=6)\n            node=6 IS ROOT -> sccs={7} {6}\n            (return to node=5, low[5]=min(3,6)=3)\n          (return to node=4, low[4]=min(4,3)=3)\n        (return to node=3, low[3]=min(3,3)=3)\n      node=3 IS ROOT -> sccs={7} {6} {5,4,3}\n      (return to node=2, low[2]=min(0,3)=0)\n    (return to node=1, low[1]=min(1,0)=0)\n  (return to node=0, low[0]=min(0,0)=0)\nnode=0 IS ROOT -> sccs={7} {6} {5,4,3} {2,1,0}\n\nFINAL: sccs = {0,1,2}  {3,4,5}  {6}  {7}",
      "textAlign": "center",
      "updated": 1788683029364,
      "version": 79,
      "versionNonce": 684035713,
      "verticalAlign": "middle"
    },
    {
      "id": "daDFDcjx_-JR4P01A0DVR",
      "type": "text",
      "x": 1876.701088942574,
      "y": -70.99578966006447,
      "width": 899.359619140625,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 1771527649,
      "version": 410,
      "versionNonce": 1400856417,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788691707999,
      "link": null,
      "locked": false,
      "text": "Kosaraju\ndfs1\nnode = 2 finishorder = {} visited = {0 0 1 0 0 0 0 0}\n    node = 0 finishorder = {} visited = {1 0 1 0 0 0 0 0}\n        node = 1 finishorder = {1} visited = {1 1 1 0 0 0 0 0}\n    node = 0 finishorder = {1,0} visited = {1 1 1 0 0 0 0 0}\n        node = 3 finishorder = {1,0} visited = {1 1 1 0 0 0 0 0}\n         ....\nnode = 2 finishorder = {1,0,7,6,5,4,3,2} visited = {1 1 1 1 1 1 1 1}\n\ndfs2\nnode = 2 finishorder = {1,0,7,6,5,4,3}  visited = {0 0 1 0 0 0 0 0} component = {2}\n    node = 1 finishorder = {1,0,7,6,5,4,3}  visited = {0 1 1 0 0 0 0 0} component = {2,1}\n        node = 0 finishorder = {1,0,7,6,5,4,3}  visited = {1 1 1 0 0 0 0 0} component = {2,1,0}\ncomponents = {{2,1,0}}\nnode = 3 finishorder = {1,0,7,6,5,4,}  visited = {1 1 1 1 0 0 0 0} component = {3}\n....\ncomponents = {{2,1,0},{3,4,5}} finishorder = {1,0,7,6,5,4}  visited = {1 1 1 1 1 1 0 0} \n...\ncomponents = {{2,1,0},{3,4,5},{6}} finishorder = {1,0,7,}  visited = {1 1 1 1 1 1 1 0} \ncomponents = {{2,1,0},{3,4,5},{6},{7}} finishorder = {}  visited = {1 1 1 1 1 1 1 1} ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kosaraju\ndfs1\nnode = 2 finishorder = {} visited = {0 0 1 0 0 0 0 0}\n    node = 0 finishorder = {} visited = {1 0 1 0 0 0 0 0}\n        node = 1 finishorder = {1} visited = {1 1 1 0 0 0 0 0}\n    node = 0 finishorder = {1,0} visited = {1 1 1 0 0 0 0 0}\n        node = 3 finishorder = {1,0} visited = {1 1 1 0 0 0 0 0}\n         ....\nnode = 2 finishorder = {1,0,7,6,5,4,3,2} visited = {1 1 1 1 1 1 1 1}\n\ndfs2\nnode = 2 finishorder = {1,0,7,6,5,4,3}  visited = {0 0 1 0 0 0 0 0} component = {2}\n    node = 1 finishorder = {1,0,7,6,5,4,3}  visited = {0 1 1 0 0 0 0 0} component = {2,1}\n        node = 0 finishorder = {1,0,7,6,5,4,3}  visited = {1 1 1 0 0 0 0 0} component = {2,1,0}\ncomponents = {{2,1,0}}\nnode = 3 finishorder = {1,0,7,6,5,4,}  visited = {1 1 1 1 0 0 0 0} component = {3}\n....\ncomponents = {{2,1,0},{3,4,5}} finishorder = {1,0,7,6,5,4}  visited = {1 1 1 1 1 1 0 0} \n...\ncomponents = {{2,1,0},{3,4,5},{6}} finishorder = {1,0,7,}  visited = {1 1 1 1 1 1 1 0} \ncomponents = {{2,1,0},{3,4,5},{6},{7}} finishorder = {}  visited = {1 1 1 1 1 1 1 1} ",
      "autoResize": true,
      "lineHeight": 1.25
    },
