      "link": null,
      "locked": false,
      "text": "WeeklyTrigger fires\n→ StartNewAsync(\"DispatchOrchestrator\")\n→ Durable runtime generates an instance ID\n→ persists status/history for that ID\n→ puts ExecutionStarted into control queue\n→ returns",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WeeklyTrigger fires\n→ StartNewAsync(\"DispatchOrchestrator\")\n→ Durable runtime generates an instance ID\n→ persists status/history for that ID\n→ puts ExecutionStarted into control queue\n→ returns",
      "autoResize": true,
      "lineHeight": 1.25
    },
