      "opacity": 100,
      "originalText": "Orchestration instance = instance ID + persisted event history/status\nIt is a logical durable workflow, not a VM or container.\nOnly one turn processes new events at a time; a later turn can run on another host instance.",
      "roughness": 1,
      "roundness": null,
      "seed": 1880710741,
      "strokeColor": "#0c8599",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "Orchestration instance = instance ID + persisted event history/status\nIt is a logical durable workflow, not a VM or container.\nOnly one turn processes new events at a time; a later turn can run on another host instance.",
      "textAlign": "center",
      "updated": 1788255345383,
      "version": 2,
      "versionNonce": 1116770504,
      "verticalAlign": "middle"
    },
