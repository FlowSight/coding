      "updated": 1784357059842,
      "link": null,
      "locked": false,
      "text": "Azure OpenAI Inference\n(GPT-4-Turbo-128K)\nDeploy: Managed PaaS\n(provisioned)\nTPM: 1M tokens/min/region\nEndpoint: POST\n/chat/completions\nAuth: managed identity\nResponse: SSE stream",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "i_aoai",
      "originalText": "Azure OpenAI Inference\n(GPT-4-Turbo-128K)\nDeploy: Managed PaaS (provisioned)\nTPM: 1M tokens/min/region\nEndpoint: POST /chat/completions\nAuth: managed identity\nResponse: SSE stream",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-07-18T06:47:52.870Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-07-18T06:47:52.861Z"
    },
    {
      "id": "exj5xSe2NcDTKq9dHVglw",
      "type": "text",
      "x": 2240.743859150884,
      "y": -455.7915589464058,
      "width": 240.6598358154297,
      "height": 300,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
