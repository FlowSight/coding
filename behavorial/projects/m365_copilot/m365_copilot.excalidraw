      "seed": 356438469,
      "version": 1,
      "versionNonce": 212456645,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784357015240,
      "link": null,
      "locked": false,
      "text": "GPU Detail (behind\nPaaS)\nNVIDIA A100 80GB\nSXM4\nContinuous batching\n(vLLM)\nPagedAttention v2 KV-\ncache\nBatch: 1-32 | ~300\ntok/s @b=16\nSpeculative decode: 2.3x\nspeed",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "i_gpu",
      "originalText": "GPU Detail (behind PaaS)\nNVIDIA A100 80GB SXM4\nContinuous batching (vLLM)\nPagedAttention v2 KV-cache\nBatch: 1-32 | ~300 tok/s @b=16\nSpeculative decode: 2.3x speed",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-07-18T06:47:52.870Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-07-18T06:47:52.861Z"
    },
