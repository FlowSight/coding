      "isDeleted": false,
      "boundElements": null,
      "updated": 1784359811600,
      "link": null,
      "locked": false,
      "text": "UC2: HR Benefits Copilot\n(Deep Dive)\n• Policy Q&A → grounded in\nPDF corpus\n• Enrollment workflow →\nDataverse forms\n• Leave balance → Workday\nAPI connector\n• Multi-language (20 locales)\n• Tokens: avg 8K/conv\n(policy docs longer)\n• Corner case: PII in\nbenefits data → DLP\n• Corner case: outdated PDF\n→ stale answers",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "uc2",
      "originalText": "UC2: HR Benefits Copilot (Deep Dive)\n• Policy Q&A → grounded in PDF corpus\n• Enrollment workflow → Dataverse forms\n• Leave balance → Workday API connector\n• Multi-language (20 locales)\n• Tokens: avg 8K/conv (policy docs longer)\n• Corner case: PII in benefits data → DLP\n• Corner case: outdated PDF → stale answers",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-07-18T12:43:10.901Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-07-18T12:43:10.887Z"
