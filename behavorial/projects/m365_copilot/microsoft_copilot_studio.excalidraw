      "versionNonce": 1168673803,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784359811604,
      "link": null,
      "locked": false,
      "text": "Citation & Grounding\nEngine\nDeploy: in-process module\nMaps generated text →\nsource chunks\nConfidence threshold: 0.80\nInline citations [1][2] with\nlinks\nFallback: \"I couldn’t find\ninfo\" if < 0.80\nDLP: strip sensitive before\ndisplay",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c_citation",
      "originalText": "Citation & Grounding Engine\nDeploy: in-process module\nMaps generated text → source chunks\nConfidence threshold: 0.80\nInline citations [1][2] with links\nFallback: \"I couldn’t find info\" if < 0.80\nDLP: strip sensitive before display",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-07-18T12:43:10.901Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-07-18T12:43:10.887Z"
