      "locked": false,
      "text": "Azure Service Bus\n(Async Job Processing)\nDeploy: Standard tier PaaS\nQueues: kb-ingest, flow-\ncallback\nDead-letter: after 5 retries\nProtocol: AMQP 1.0 / 5671\nTLS\nUse: document ingestion\npipeline\nUse: Power Automate async\ncallback",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "d_sbus",
      "originalText": "Azure Service Bus\n(Async Job Processing)\nDeploy: Standard tier PaaS\nQueues: kb-ingest, flow-callback\nDead-letter: after 5 retries\nProtocol: AMQP 1.0 / 5671 TLS\nUse: document ingestion pipeline\nUse: Power Automate async callback",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-07-18T12:43:10.901Z",
