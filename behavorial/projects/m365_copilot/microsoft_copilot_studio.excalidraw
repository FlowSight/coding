      "boundElements": null,
      "updated": 1784359811604,
      "link": null,
      "locked": false,
      "text": "Moderation & Guardrails\nDeploy: in-process module\n• Topic scope\nenforcement\n• \"Don’t answer\" topic\nlist\n• Custom instructions\n(persona)\n• Hallucination check\n(NLI)\n• PII redaction before\nresponse\nAdmin toggle: generative\non/off",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c_moderate",
      "originalText": "Moderation & Guardrails\nDeploy: in-process module\n• Topic scope enforcement\n• \"Don’t answer\" topic list\n• Custom instructions (persona)\n• Hallucination check (NLI)\n• PII redaction before response\nAdmin toggle: generative on/off",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-07-18T12:43:10.901Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-07-18T12:43:10.887Z"
