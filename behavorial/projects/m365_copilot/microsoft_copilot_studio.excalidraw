      "updated": 1784359811604,
      "link": null,
      "locked": false,
      "text": "Azure AI Language\n(CLU - Intent + Entity\nModels)\nDeploy: Managed PaaS\nPer-bot trained model\nIntents: up to 500 per bot\nEntities: prebuilt + custom\nLatency: P95 < 100ms\nFallback to GPT if CLU <\n0.7",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c_clu",
      "originalText": "Azure AI Language\n(CLU - Intent + Entity Models)\nDeploy: Managed PaaS\nPer-bot trained model\nIntents: up to 500 per bot\nEntities: prebuilt + custom\nLatency: P95 < 100ms\nFallback to GPT if CLU < 0.7",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-07-18T12:43:10.901Z",
      "source": "frontend_sync",
